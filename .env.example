# Copy this file to .env and fill in your values.
# .env is gitignored — never commit secrets.

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# LLM model to use via Groq
LLM_MODEL=llama-3.3-70b-versatile

# Embedding backend: 'local' or 'cohere'.
# Local runs bge-small in-process (free, no key, slow on small CPUs) but
# requires the extra `requirements-local.txt` install for torch and
# sentence-transformers.
# Cohere runs over HTTPS, much faster on small-instance cloud hosts. This
# is what the live deployment uses.
# Switching backends requires rebuilding Chroma: dimensions differ.
EMBEDDING_BACKEND=local

# Used when EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Used when EMBEDDING_BACKEND=cohere — get one at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-english-v3.0

# Chroma persistence directory
CHROMA_DIR=./chromadb

# Retrieval settings
TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=80

# API and UI ports (local development)
API_PORT=8000
UI_PORT=8501

# Optional: cache LLM responses on disk during dev iteration.
# Set to 1 to enable. Persisted to .llm_cache.db (gitignored).
# Leave unset in production so cache misses don't mask real failures.
LLM_CACHE=
